# 쿠팡 로그인 정보
COUPANG_USER_ID=your_coupang_id
COUPANG_USER_PW=your_coupang_password

# 스케줄러 설정
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_HOUR=9
AUTO_UPDATE_MINUTE=15

# Supabase (배포 환경)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# CORS (배포 환경 - Vercel 도메인)
ALLOWED_ORIGINS=*

# Chrome headless 모드 (로컬에서 브라우저 창을 보려면 false)
HEADLESS_MODE=true
